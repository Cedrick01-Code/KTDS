# MongoDB Atlas: create a database user, allow the deployment IP address, then
# paste the Atlas driver URI here. Encode special characters in the password.
DATABASE_URL="mongodb+srv://<username>:<password>@<cluster-url>/ktds?retryWrites=true&w=majority"

# Use a long, random value in each deployed environment.
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="8h"
PORT=3000